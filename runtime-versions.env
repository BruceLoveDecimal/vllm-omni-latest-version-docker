# Stable release alignment used by Dockerfile.
VLLM_OMNI_VERSION=0.28.0
VLLM_VERSION=0.28.0
# vLLM 0.28.0 ships CUDA 13.0-compatible binaries by default.
CUDA_COMPATIBILITY=13.0
# The exact Python, PyTorch, CUDA runtime and transitive package versions are
# emitted by scripts/inspect-runtime.sh from the built image.
